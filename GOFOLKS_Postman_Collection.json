  "item": [
    {
      "name": "01 — Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.test(\"Сервис GOFOLKS отвечает\", function () { pm.expect(data.status).to.eql(\"ok\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — Регистрация основного пользователя",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Создаёт нового тестового пользователя с уникальными username/email и сохраняет JWT в переменную token. При повторном запуске будет создан новый пользователь."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const stamp = Date.now().toString();",
              "pm.collectionVariables.set(\"username\", \"gofolks_\" + stamp);",
              "pm.collectionVariables.set(\"email\", \"gofolks_\" + stamp + \"@example.com\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Регистрация успешна (201)\", function () { pm.response.to.have.status(201); });",
              "const data = pm.response.json();",
              "if (data && data.token) pm.collectionVariables.set(\"token\", data.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 — Вход (проверка логина)",
